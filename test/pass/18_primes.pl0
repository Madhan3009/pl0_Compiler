{ A complete program: count the primes below 100 }
const limit = 100;
var n, d, isprime, count;

procedure check;
    begin
        isprime := 1;
        d := 2;
        while d * d <= n do
        begin
            if n / d * d = n then isprime := 0;
            d := d + 1
        end
    end;

begin
    count := 0;
    n := 2;
    while n < limit do
    begin
        call check;
        if isprime = 1 then count := count + 1;
        n := n + 1
    end
end.
